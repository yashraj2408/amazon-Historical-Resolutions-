# Photo Organizer Backend - Environment Variables
# Copy this file to .env and modify as needed

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS - Comma-separated origins (no trailing slashes!)
# Development: http://localhost:5173
# Production: https://yourusername.github.io
CORS_ORIGINS=http://localhost:5173

# File Upload Limits
MAX_FILE_SIZE=10485760          # 10MB in bytes
MAX_FILES_PER_JOB=50            # Max files per upload
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Image Processing
MAX_IMAGE_DIMENSION=1920        # Max width/height for processing
FACE_DETECTION_MODEL=hog        # 'hog' (fast) or 'cnn' (accurate, slower)

# Face Clustering (DBSCAN)
CLUSTERING_EPS=0.5              # Distance threshold for clustering
CLUSTERING_MIN_SAMPLES=2        # Minimum faces to form a cluster

# Job Management
JOB_TTL_HOURS=24                # Hours before job data is cleaned up

# Logging
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR